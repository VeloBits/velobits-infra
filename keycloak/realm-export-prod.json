{
  "_comment": "Production realm export — placeholder for production deploy. Not imported by docker compose --profile dev. Production deploy will (a) provision a separate Keycloak-Prod instance, (b) import this realm, (c) rotate every secret, (d) wire real SMTP, (e) configure social IdPs (Google, GitHub).",
  "realm": "Velobits-Prod",
  "enabled": true,
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 2592000,
  "reuseRefreshTokens": false,
  "refreshTokenMaxReuse": 0,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "defaultSignatureAlgorithm": "RS256",
  "passwordPolicy": "length(8) and notUsername and notEmail and hashAlgorithm(pbkdf2-sha256) and hashIterations(100000)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "otpPolicy": {
    "type": "totp",
    "algorithm": "HmacSHA1",
    "initialCounter": 0,
    "digits": 6,
    "lookAheadWindow": 1,
    "period": 30
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard VeloBits user (default role across all products)"
      }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "fixmytext",
      "name": "FixMyText Production (public, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://fixmytext.velobits.dev/auth/callback"
      ],
      "webOrigins": [
        "https://fixmytext.velobits.dev"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "fixmytext-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fixmytext-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "fixmytext-backend",
      "name": "FixMyText Backend Production (confidential, service account)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "PLACEHOLDER_ROTATED_ON_PRODUCTION_PROVISION",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "chat",
      "name": "Chat Production (placeholder for future Velobits product)",
      "enabled": false,
      "publicClient": true,
      "redirectUris": ["https://chat.velobits.dev/*"],
      "webOrigins": ["https://chat.velobits.dev"]
    },
    {
      "clientId": "notes",
      "name": "Notes Production (placeholder for future Velobits product)",
      "enabled": false,
      "publicClient": true,
      "redirectUris": ["https://notes.velobits.dev/*"],
      "webOrigins": ["https://notes.velobits.dev"]
    }
  ],
  "smtpServer": {},
  "loginTheme": "fixmytext",
  "emailTheme": "fixmytext"
}
