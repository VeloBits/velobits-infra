{
  "_comment": "Production realm export — placeholder for Sprint 9 production deploy. Not imported by docker compose --profile dev. Sprint 9 will (a) provision a separate Keycloak-Prod instance, (b) import this realm, (c) rotate every secret, (d) wire real SMTP, (e) configure social IdPs (Google, GitHub) per Sprint 4c follow-up.",
  "realm": "Velobits-Prod",
  "enabled": true,
  "sslRequired": "all",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 2592000,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard VeloBits user (default role across all products)"
      }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "fixmytext",
      "name": "FixMyText Production (public, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://fixmytext.velobits.dev/auth/callback",
        "https://fixmytext.velobits.dev/*"
      ],
      "webOrigins": [
        "https://fixmytext.velobits.dev"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "fixmytext-backend",
      "name": "FixMyText Backend Production (confidential, service account)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "PLACEHOLDER_ROTATED_ON_SPRINT_9_PROVISION",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "chat",
      "name": "Chat Production (placeholder for future Velobits product)",
      "enabled": false,
      "publicClient": true,
      "redirectUris": ["https://chat.velobits.dev/*"],
      "webOrigins": ["https://chat.velobits.dev"]
    },
    {
      "clientId": "notes",
      "name": "Notes Production (placeholder for future Velobits product)",
      "enabled": false,
      "publicClient": true,
      "redirectUris": ["https://notes.velobits.dev/*"],
      "webOrigins": ["https://notes.velobits.dev"]
    }
  ],
  "smtpServer": {},
  "loginTheme": "fixmytext",
  "emailTheme": "fixmytext"
}
