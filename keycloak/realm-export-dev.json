{
  "realm": "Velobits-Dev",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 2592000,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "defaultSignatureAlgorithm": "RS256",
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and notUsername and notEmail and hashAlgorithm(pbkdf2-sha256) and hashIterations(600000)",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard VeloBits user (default role across all products)"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "clientId": "develop-fixmytext",
      "name": "FixMyText Dev (public, PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://develop-fixmytext.velobits.dev/auth/callback",
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": [
        "http://develop-fixmytext.velobits.dev",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "fixmytext-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "fixmytext-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "fixmytext-backend",
      "name": "FixMyText Backend Dev (confidential, service account)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "PLACEHOLDER_ROTATED_ON_FIRST_BOOT",
      "attributes": {
        "access.token.lifespan": "300"
      }
    },
    {
      "clientId": "develop-chat",
      "name": "Chat Dev (placeholder for future Velobits product)",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://develop-chat.velobits.dev/auth/callback"
      ],
      "webOrigins": [
        "http://develop-chat.velobits.dev"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "develop-notes",
      "name": "Notes Dev (placeholder for future Velobits product)",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://develop-notes.velobits.dev/auth/callback"
      ],
      "webOrigins": [
        "http://develop-notes.velobits.dev"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "smtpServer": {},
  "loginTheme": "fixmytext",
  "emailTheme": "fixmytext"
}