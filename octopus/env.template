# Octopus environment template — rendered into the runtime .env consumed by
# docker compose. Octopus substitutes the tokens below ("Substitute Variables
# in Templates" feature), then octopus/deploy.sh copies this file to
# <package root>/.env with mode 600.
#
# Every token maps 1:1 to an Octopus PROJECT VARIABLE of the same name, scoped
# to the Development / Production environment. Mark passwords and secrets as
# SENSITIVE in Octopus. Variable table: docs/octopus-deployment.md.
#
# Tokens wrapped in an "if" block are OPTIONAL: they render to an empty value
# when the variable is not defined in Octopus, and the stack degrades
# gracefully (docker-compose.yml defaults kick in; bootstrap.sh skips social
# IdPs / SMTP with blank credentials). Bare tokens are REQUIRED — deploy.sh
# aborts if any are left unsubstituted.

# ── Deployment identity (REQUIRED) ───────────────────────────────────────────
# Keeps compose project labels distinct per environment on a shared host.
COMPOSE_PROJECT_NAME=#{COMPOSE_PROJECT_NAME}
# Public hostname Keycloak advertises (wired into KC_HOSTNAME by
# octopus/docker-compose.deploy.yml). Dev: auth-dev.velobits.dev.
KC_HOSTNAME=#{KC_HOSTNAME}

# ── Keycloak admin + DB credentials (passwords REQUIRED + sensitive; ─────────
# admin user optional, compose defaults it to "admin")
KEYCLOAK_DEV_ADMIN_USER=#{if KEYCLOAK_DEV_ADMIN_USER}#{KEYCLOAK_DEV_ADMIN_USER}#{/if}
KEYCLOAK_DEV_ADMIN_PASSWORD=#{KEYCLOAK_DEV_ADMIN_PASSWORD}
KEYCLOAK_DEV_DB_USER=#{KEYCLOAK_DEV_DB_USER}
KEYCLOAK_DEV_DB_PASSWORD=#{KEYCLOAK_DEV_DB_PASSWORD}

# ── Service account for product backends (optional, secret is sensitive) ─────
# Must match the values used by account-svc in the product stack.
KEYCLOAK_SERVICE_ACCOUNT_ID=#{if KEYCLOAK_SERVICE_ACCOUNT_ID}#{KEYCLOAK_SERVICE_ACCOUNT_ID}#{/if}
KEYCLOAK_SERVICE_ACCOUNT_SECRET=#{if KEYCLOAK_SERVICE_ACCOUNT_SECRET}#{KEYCLOAK_SERVICE_ACCOUNT_SECRET}#{/if}

# ── Backchannel logout (optional — compose defaults to the kong dev URL) ─────
BACKCHANNEL_LOGOUT_URL=#{if BACKCHANNEL_LOGOUT_URL}#{BACKCHANNEL_LOGOUT_URL}#{/if}
KEYCLOAK_FRONTEND_CLIENT_ID=#{if KEYCLOAK_FRONTEND_CLIENT_ID}#{KEYCLOAK_FRONTEND_CLIENT_ID}#{/if}

# ── Social login (optional — blank pair disables the button) ─────────────────
GOOGLE_OAUTH_CLIENT_ID=#{if GOOGLE_OAUTH_CLIENT_ID}#{GOOGLE_OAUTH_CLIENT_ID}#{/if}
GOOGLE_OAUTH_CLIENT_SECRET=#{if GOOGLE_OAUTH_CLIENT_SECRET}#{GOOGLE_OAUTH_CLIENT_SECRET}#{/if}
GH_OAUTH_CLIENT_ID=#{if GH_OAUTH_CLIENT_ID}#{GH_OAUTH_CLIENT_ID}#{/if}
GH_OAUTH_CLIENT_SECRET=#{if GH_OAUTH_CLIENT_SECRET}#{GH_OAUTH_CLIENT_SECRET}#{/if}

# ── SMTP (optional — bootstrap.sh only configures it when host+user set) ─────
SMTP_HOST=#{if SMTP_HOST}#{SMTP_HOST}#{/if}
SMTP_PORT=#{if SMTP_PORT}#{SMTP_PORT}#{/if}
SMTP_USERNAME=#{if SMTP_USERNAME}#{SMTP_USERNAME}#{/if}
SMTP_PASSWORD=#{if SMTP_PASSWORD}#{SMTP_PASSWORD}#{/if}
EMAIL_FROM=#{if EMAIL_FROM}#{EMAIL_FROM}#{/if}
