# Octopus environment template for the PRODUCTION stack
# (docker-compose-prod.yml — Traefik + Let's Encrypt and the baked
# velobits-auth image; the identity database is REMOTE, managed by Aiven).
# The Development stack has its own template: octopus/env.dev.template.
#
# Octopus substitutes the tokens below ("Substitute Variables in Templates"
# feature), then octopus/deploy.sh copies this file to <package root>/.env
# with mode 600 when deploying to the Production environment.
#
# Every token maps 1:1 to an Octopus PROJECT VARIABLE of the same name, scoped
# to the Production environment. Mark passwords as SENSITIVE in Octopus.
# Mirrors the PRODUCTION section of .env.example.
#
# Deliberately small: KC_HOSTNAME (https://auth.velobits.dev) is fixed in the
# compose file, and SMTP / social IdPs / account-svc are NOT auto-provisioned
# in prod — configure them in the admin console or run keycloak/bootstrap.sh
# ad-hoc (docs/keycloak-production-setup.md).

# ── Deployment identity (REQUIRED) ───────────────────────────────────────────
# Must stay stable across deploys: compose prefixes volume names with it, so
# changing it would orphan the keycloak-prod-pgdata identity database.
COMPOSE_PROJECT_NAME=#{COMPOSE_PROJECT_NAME}

# ── Let's Encrypt (REQUIRED) ─────────────────────────────────────────────────
# Expiry/renewal notices from the ACME CA go here.
ACME_EMAIL=#{ACME_EMAIL}

# ── Keycloak bootstrap admin (password REQUIRED + sensitive; user optional, ──
# compose defaults it to "admin"). Rotate via the admin console after go-live.
KEYCLOAK_PROD_ADMIN_USER=#{if KEYCLOAK_PROD_ADMIN_USER}#{KEYCLOAK_PROD_ADMIN_USER}#{/if}
KEYCLOAK_PROD_ADMIN_PASSWORD=#{KEYCLOAK_PROD_ADMIN_PASSWORD}

# ── Keycloak identity database — remote Aiven Postgres (REQUIRED, ────────────
# password sensitive). Values come from the Aiven console service page:
# URL is the JDBC form of the service URI — keep sslmode=require, Aiven
# enforces TLS. Example:
#   jdbc:postgresql://pg-xxxxx-yyy.aivencloud.com:12345/defaultdb?sslmode=require
KEYCLOAK_PROD_DB_URL=#{KEYCLOAK_PROD_DB_URL}
KEYCLOAK_PROD_DB_USER=#{KEYCLOAK_PROD_DB_USER}
KEYCLOAK_PROD_DB_PASSWORD=#{KEYCLOAK_PROD_DB_PASSWORD}
