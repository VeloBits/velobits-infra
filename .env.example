# velobits-infra environment variables
# Copy this file to .env (git-ignored) and fill in values.

# ── Keycloak dev admin + DB credentials ──────────────────────────────────────
# Generate strong values and store them in your password manager:
#   openssl rand -base64 32   # → KEYCLOAK_DEV_ADMIN_PASSWORD
#   openssl rand -base64 24   # → KEYCLOAK_DEV_DB_PASSWORD
KEYCLOAK_DEV_ADMIN_USER=admin
KEYCLOAK_DEV_ADMIN_PASSWORD=

# Keycloak dev DB credentials - used by the Keycloak container to connect to
# its LOCAL Postgres container (laptop quickstart). Deployed environments use
# a remote Aiven database instead, injected via Octopus variables — see
# docs/octopus-deployment.md.
KEYCLOAK_DEV_DB_USER=keycloak
KEYCLOAK_DEV_DB_PASSWORD=

# ── Service account for product backends (account-svc) ──────────────────────
# bootstrap.sh creates/updates this confidential client on the Velobits
# realm and grants it manage-users/view-users. The product stack
# (fixmytext-backend .env) must use the SAME ID + SECRET.
# Generate: openssl rand -base64 32
KEYCLOAK_SERVICE_ACCOUNT_ID=account-svc
KEYCLOAK_SERVICE_ACCOUNT_SECRET=

# NOTE: Backchannel logout is NOT an env var. Each app's OIDC client declares
# its own `backchannel.logout.url` in keycloak/realm-export-{dev,prod}.json
# (dev: http://kong:8000/..., prod: https://api.velobits.dev/...), and
# bootstrap.sh syncs those attributes onto the live realm on every run.
# To onboard a new app, add its client to the realm export - no env change.

# ── Social login providers ───────────────────────────────────────────────────
# These wire the Google/GitHub "Sign in with…" buttons on the Keycloak login
# page. bootstrap.sh registers the matching identity providers on the
# Velobits realm via the Admin API. Leave a pair BLANK to skip it -
# a provider is only provisioned when both its ID and SECRET are set, so the
# corresponding button simply won't appear (no error, graceful degradation).
#
# Google OAuth app - create at console.cloud.google.com
# Authorized redirect URI:
#   http://localhost:8080/realms/Velobits/broker/google/endpoint
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth app - create at github.com/settings/developers
# Authorization callback URL:
#   http://localhost:8080/realms/Velobits/broker/github/endpoint
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# ── SMTP (Keycloak realm email: verification, reset) ─────────────────────────
# Optional - bootstrap.sh only configures realm SMTP when SMTP_HOST and
# SMTP_USERNAME are both set. Shared by BOTH stacks (dev + prod bootstrap).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION identity stack (docker-compose-prod.yml, auth.velobits.dev)
# ══════════════════════════════════════════════════════════════════════════════
# Only needed on the production host. The OAuth / SMTP / service-account /
# backchannel vars above are reused by the prod bootstrap service — set them to
# PRODUCTION values there (do NOT reuse dev secrets), and remember the prod
# Google/GitHub OAuth apps must use the prod redirect URIs, e.g.:
#   https://auth.velobits.dev/realms/Velobits-Prod/broker/google/endpoint

# Keycloak prod admin (bootstrap admin — rotate/replace after first login).
#   openssl rand -base64 32   # → KEYCLOAK_PROD_ADMIN_PASSWORD
KEYCLOAK_PROD_ADMIN_USER=admin
KEYCLOAK_PROD_ADMIN_PASSWORD=

# Keycloak prod DB — REMOTE managed Postgres (Aiven free plan); no database
# container runs on the prod host. Take all three values from the Aiven
# console service page. URL is the JDBC form of the service URI — keep
# sslmode=require (Aiven enforces TLS):
#   jdbc:postgresql://pg-xxxxx-yyy.aivencloud.com:12345/defaultdb?sslmode=require
# (Local fallback: `--profile local-db` + point the URL at
#  jdbc:postgresql://keycloak-db:5432/keycloak_prod_db)
KEYCLOAK_PROD_DB_URL=
KEYCLOAK_PROD_DB_USER=
KEYCLOAK_PROD_DB_PASSWORD=

# Let's Encrypt registration email — expiry/renewal notices go here.
ACME_EMAIL=
