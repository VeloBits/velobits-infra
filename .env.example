# velobits-infra environment variables
# Copy this file to .env (git-ignored) and fill in values.

# ── Keycloak dev admin + DB credentials ──────────────────────────────────────
# Generate strong values and store them in your password manager:
#   openssl rand -base64 32   # → KEYCLOAK_DEV_ADMIN_PASSWORD
#   openssl rand -base64 24   # → KEYCLOAK_DEV_DB_PASSWORD
KEYCLOAK_DEV_ADMIN_USER=admin
KEYCLOAK_DEV_ADMIN_PASSWORD=
KEYCLOAK_DEV_DB_USER=keycloak
KEYCLOAK_DEV_DB_PASSWORD=

# ── Service account for product backends (account-svc) ──────────────────────
# bootstrap.sh creates/updates this confidential client on the Velobits-Dev
# realm and grants it manage-users/view-users. The product stack
# (fixmytext-backend .env) must use the SAME ID + SECRET.
# Generate: openssl rand -base64 32
KEYCLOAK_SERVICE_ACCOUNT_ID=account-svc
KEYCLOAK_SERVICE_ACCOUNT_SECRET=

# ── Backchannel logout ───────────────────────────────────────────────────────
# Keycloak POSTs backchannel logout tokens here on OIDC SLO.
# In dev: http://kong:8000/... (Kong joins velobits-net from the app stack).
# In prod: https://api.velobits.dev/api/v1/auth/backchannel-logout
BACKCHANNEL_LOGOUT_URL=http://kong:8000/api/v1/auth/backchannel-logout
# The frontend OIDC client that issued the user sessions (public PKCE client).
KEYCLOAK_FRONTEND_CLIENT_ID=develop-fixmytext

# ── Social login providers ───────────────────────────────────────────────────
# These wire the Google/GitHub "Sign in with…" buttons on the Keycloak login
# page. bootstrap.sh registers the matching identity providers on the
# Velobits-Dev realm via the Admin API. Leave a pair BLANK to skip it —
# a provider is only provisioned when both its ID and SECRET are set, so the
# corresponding button simply won't appear (no error, graceful degradation).
#
# Google OAuth app — create at console.cloud.google.com
# Authorized redirect URI:
#   http://localhost:8080/realms/Velobits-Dev/broker/google/endpoint
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth app — create at github.com/settings/developers
# Authorization callback URL:
#   http://localhost:8080/realms/Velobits-Dev/broker/github/endpoint
GH_OAUTH_CLIENT_ID=
GH_OAUTH_CLIENT_SECRET=

# ── SMTP (Keycloak realm email: verification, reset) ─────────────────────────
# Optional — bootstrap.sh only configures realm SMTP when SMTP_HOST and
# SMTP_USERNAME are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
